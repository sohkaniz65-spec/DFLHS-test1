# Anthropic API 키 (https://console.anthropic.com 에서 발급). 이 파일을 .env 로 복사해서 채우세요.
ANTHROPIC_API_KEY=

# 사용할 모델 (기본: claude-opus-5)
STUDIO_MODEL=claude-opus-5

# 생각 깊이: low / medium / high / xhigh / max  (높을수록 정확하지만 비용·시간 증가)
STUDIO_EFFORT=high

# 안전 필터 오탐 시 다른 모델로 자동 재시도 (on/off)
STUDIO_FALLBACKS=on

# 포트
PORT=4173

# 서버 PDF 저장에 쓸 크롬/엣지 실행 파일 경로 (비워두면 설치된 Chrome → Edge 순으로 자동 탐색)
CHROME_PATH=

# API 없이 화면·디자인만 확인하는 연습 모드 (1 이면 가짜 데이터 생성)
MOCK_CLAUDE=0
